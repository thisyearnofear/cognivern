{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@backend/*": ["src/backend/*"],
      "@cognivern/shared": ["packages/shared/src/index.ts"],
      "@cognivern/shared/api": ["packages/shared/src/api.ts"],
      "@cognivern/shared/cre": ["packages/shared/src/cre.ts"],
      "@cognivern/shared/governance": ["packages/shared/src/governance.ts"],
      "@cognivern/shared/rails": ["packages/shared/src/rails.ts"],
      "@cognivern/shared/receipts": ["packages/shared/src/receipts.ts"]
    },
    "sourceMap": true,
    "declaration": false,
    "checkJs": false,
    "noEmit": false
  },
  "include": ["src/**/*", "packages/shared/src/**/*"],
  "exclude": [
    "src/frontend/**/*",
    "src/backend/modules/cloudflare-agents/**/*",
    "node_modules",
    "dist",
    "**/*.test.ts"
  ]
}
