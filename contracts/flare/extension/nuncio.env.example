# Cognivern Flare FCC — nuncio-vultr (INTERNAL). Do not commit real keys.
LANGUAGE=go

# Fill before Coston2 deploy/register (faucet: https://faucet.flare.network/coston2)
INITIAL_OWNER="0xREPLACE_ME"
DEPLOYMENT_PRIVATE_KEY="REPLACE_ME_HEX_NO_0x_OR_WITH"
PROXY_PRIVATE_KEY="REPLACE_ME_HEX_NO_0x_OR_WITH"

CHAIN_URL=https://coston2-api.flare.network/ext/C/rpc
CHAIN_ID=114
ADDRESSES_FILE=./config/coston2/deployed-addresses.json
LOCAL_MODE=false
SIMULATED_TEE=true
NORMAL_PROXY_URL=https://tee-proxy-coston2-1.flare.rocks

# Public URL once Traefik DNS is live (or cloudflared). Must be HTTPS for providers.
EXT_PROXY_URL=https://flare-tee.persidian.com

# Exotic host binds — avoid Coolify/Traefik/magiclens collisions (see OPS.md)
REDIS_BIND=127.0.0.1:16379
EXT_PROXY_INTERNAL_BIND=127.0.0.1:7663
EXT_PROXY_EXTERNAL_BIND=0.0.0.0:7667

COMPOSE_NETWORK=cognivern-flare-coston2
LOG_LEVEL=INFO
