# syntax=docker/dockerfile:1.7

# Lean backend image: esbuild bundle + native deps (same pattern as
# ops/deploy/build-bundle.mjs / deploy-lean.sh).

FROM node:22-bookworm-slim AS build
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 make g++ git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc* ./
COPY packages ./packages
COPY src ./src
COPY config ./config
COPY ops/deploy/build-bundle.mjs ./ops/deploy/build-bundle.mjs
COPY examples/copilot/instructions.md ./examples/copilot/instructions.md
COPY tsconfig.json ./

# Install enough to run esbuild + resolve workspace aliases.
RUN pnpm install --frozen-lockfile

RUN node ops/deploy/build-bundle.mjs

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 make g++ curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Layout matches lean deploy: server.mjs resolves mcp-config via
# path.join(__dirname, "..", "config", "mcp-config.json").
COPY --from=build /app/deploy-bundle/ ./bundle/
COPY config/mcp-config.json ./config/mcp-config.json
COPY deploy/self-host/scripts/seed-demo.mjs ./bundle/seed-demo.mjs
COPY deploy/self-host/scripts/docker-entrypoint.sh ./bundle/docker-entrypoint.sh

WORKDIR /app/bundle
RUN npm install --omit=dev && chmod +x ./docker-entrypoint.sh

ENV NODE_ENV=production \
    PORT=3001 \
    DB_PATH=/app/data/cognivern.db

VOLUME ["/app/data"]
EXPOSE 3001

HEALTHCHECK --interval=15s --timeout=5s --start-period=40s --retries=5 \
  CMD curl -fsS "http://127.0.0.1:${PORT}/health" || exit 1

ENTRYPOINT ["./docker-entrypoint.sh"]
CMD ["node", "server.mjs"]
