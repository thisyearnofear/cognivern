# Copy to .env before first `docker compose up`.
# Demo-only secrets — replace before any shared or internet-facing deploy.

JWT_SECRET=dev-only-change-me-jwt-32chars-min
OWS_VAULT_SECRET=dev-only-change-me-vault-32chars

# Browser origin for CORS (must match how you open the UI)
CORS_ORIGIN=http://localhost:8080

FRONTEND_PORT=8080
BACKEND_PORT=3001
OTLP_HTTP_PORT=4318
JAEGER_UI_PORT=16686

# Seed a demo workspace + funded mandate on first healthy boot
SEED_DEMO=true
